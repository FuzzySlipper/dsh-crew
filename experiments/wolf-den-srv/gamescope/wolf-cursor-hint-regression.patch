+#[test]
+fn cursor_position_hint_is_used_after_unlock() {
+    let mut f = Fixture::new();
+    f.round_trip();
+    f.create_window(320, 240);
+
+    let initial_location = Point::from((15.0, 45.0));
+    f.server.pointer_motion_absolute(0, initial_location);
+    f.round_trip();
+    clean_events(f.client.get_client_events());
+
+    let lock = f.client.lock_pointer();
+    f.round_trip();
+
+    let surface = f
+        .server
+        .space
+        .elements()
+        .next()
+        .unwrap()
+        .wl_surface()
+        .unwrap()
+        .into_owned();
+    let pointer = f.server.seat.get_pointer().unwrap();
+    let hinted_location = Point::from((47.0, 63.0));
+    <crate::comp::State as PointerConstraintsHandler>::cursor_position_hint(
+        &mut f.server,
+        &surface,
+        &pointer,
+        hinted_location,
+    );
+
+    // The hint is applied while the pointer is locked. Once the client unlocks,
+    // the next relative motion must start at the hinted location.
+    lock.destroy();
+    f.round_trip();
+
+    let delta = Point::from((10.0, 15.0));
+    f.server.pointer_motion(0, 0, delta, delta);
+    f.round_trip();
+
+    assert_eq!(
+        f.server.pointer_location,
+        hinted_location + delta,
+        "relative motion should be integrated from the cursor position hint"
+    );
+}
